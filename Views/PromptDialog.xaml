<Window x:Class="GDriveTelegramSender.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GDriveTelegramSender.Ui"
        Title="{ui:Loc Prompt_DefaultTitle}"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="400" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SettingsPaper}"
        Foreground="{DynamicResource SettingsText}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   Margin="0,0,0,12"
                   Text="{ui:Loc Prompt_VerificationCode_Body}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{DynamicResource SettingsText}"
                   VerticalAlignment="Center"/>

        <!-- Text input for regular text/code -->
        <TextBox x:Name="InputTextBox"
                 Grid.Row="1"
                 Style="{StaticResource ModernTextBox}"
                 Height="35"
                 Visibility="Visible"
                 KeyDown="InputTextBox_KeyDown"/>

        <!-- PasswordBox for 2FA password -->
        <PasswordBox x:Name="InputPasswordBox"
                     Grid.Row="1"
                     Style="{StaticResource ModernPasswordBox}"
                     Height="35"
                     Visibility="Collapsed"
                     KeyDown="InputPasswordBox_KeyDown"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelBtn"
                    Content="{ui:Loc Common_Cancel}"
                    Style="{StaticResource SecondaryButton}"
                    Width="90" Height="34"
                    Margin="0,0,8,0"
                    Click="CancelBtn_Click"/>

            <Button x:Name="OkBtn"
                    Content="{ui:Loc Common_Confirm}"
                    Style="{StaticResource PrimaryButton}"
                    Width="120" Height="34"
                    Click="OkBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
