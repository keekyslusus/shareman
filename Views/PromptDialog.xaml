<Window x:Class="GDriveTelegramSender.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GDriveTelegramSender.Ui"
        Title="Авторизация Telegram"
        Height="220" Width="400"
        MinHeight="200" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SettingsPaper}"
        Foreground="{DynamicResource SettingsText}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                    Background="{DynamicResource SettingsSurface}"
                    BorderBrush="{DynamicResource SettingsLine}" BorderThickness="1"
                    Margin="0,0,12,0" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsAccent}" Data="{x:Static ui:AppIcons.LockOutlined}"/>
                </Viewbox>
            </Border>

            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       Text="Введите проверочный код:"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource SettingsText}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Text input for regular text/code -->
        <TextBox x:Name="InputTextBox"
                 Grid.Row="1"
                 Style="{StaticResource ModernTextBox}"
                 Height="35"
                 Visibility="Visible"
                 KeyDown="InputTextBox_KeyDown"/>

        <!-- PasswordBox for 2FA password -->
        <PasswordBox x:Name="InputPasswordBox"
                      Grid.Row="1"
                      Style="{StaticResource ModernPasswordBox}"
                      Height="35"
                      Visibility="Collapsed"
                      KeyDown="InputPasswordBox_KeyDown"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn"
                    Content="Отмена"
                    Style="{StaticResource SecondaryButton}"
                    Width="90" Height="34"
                    Margin="0,0,8,0"
                    Click="CancelBtn_Click"/>

            <Button x:Name="OkBtn"
                    Content="Подтвердить"
                    Style="{StaticResource PrimaryButton}"
                    Width="120" Height="34"
                    Click="OkBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
