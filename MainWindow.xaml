<Window x:Class="GDriveTelegramSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GDriveTelegramSender.Ui"
        xmlns:effects="clr-namespace:GDriveTelegramSender.Ui.Effects"
        Title="{ui:Loc App_Title}"
        Icon="Resources/shareman.ico"
        Height="740" Width="520"
        MinHeight="640" MinWidth="470"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SettingsPaper}"
        Foreground="{DynamicResource SettingsText}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Views Container -->
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{ui:Loc App_Header_Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{ui:Loc App_Header_Subtitle}" Style="{StaticResource RowSubtitle}"/>
            </StackPanel>

            <Button x:Name="ToggleSettingsBtn"
                    Grid.Column="1"
                    Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Center"
                    Padding="12,7"
                    Click="ToggleSettingsBtn_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Path x:Name="ToggleSettingsIcon" Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.SettingsOutlined}"/>
                    </Viewbox>
                    <TextBlock x:Name="ToggleSettingsText" Text="{ui:Loc Common_Settings}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Animated Views Host -->
        <AdornerDecorator Grid.Row="1">
            <Grid x:Name="ViewsTransitionSurface">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>

                <!-- 1. MAIN SEND VIEW -->
                <Grid x:Name="SendView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Selected File -->
                        <RowDefinition Height="*"/>
                        <!-- Recipient Contacts List -->
                        <RowDefinition Height="Auto"/>
                        <!-- Comment -->
                        <RowDefinition Height="Auto"/>
                        <!-- Progress Card -->
                        <RowDefinition Height="Auto"/>
                        <!-- Actions -->
                    </Grid.RowDefinitions>

                    <!-- Section: Selected File -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{ui:Loc Send_SelectedFile_Title}" Style="{StaticResource SectionTitle}" Margin="2,0,0,6"/>
                        <Border Style="{StaticResource Hero}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock x:Name="FileNameText"
                                               Text="{ui:Loc Send_NoFileSelected}"
                                               Style="{StaticResource RowTitle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="FileSizeText"
                                               Text="{ui:Loc Send_DragDropOrChoose}"
                                               Style="{StaticResource RowSubtitle}"/>
                                </StackPanel>

                                <Button x:Name="ChangeFileBtn"
                                        Grid.Column="1"
                                        Style="{StaticResource SecondaryButton}"
                                        VerticalAlignment="Center"
                                        Click="ChangeFileBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                            <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.FolderOpenOutlined}"/>
                                        </Viewbox>
                                        <TextBlock x:Name="ChangeFileBtnText" Text="{ui:Loc Common_Choose}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Section: Recipient Contacts -->
                    <Grid Grid.Row="1" Margin="0,4,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{ui:Loc Send_Recipient_Title}" Style="{StaticResource SectionTitle}" Margin="2,4,0,6"/>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Search -->
                                    <RowDefinition Height="*"/>
                                    <!-- Contacts List -->
                                </Grid.RowDefinitions>

                                <!-- Search Input Row -->
                                <Border Grid.Row="0" BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,0,0,1" Padding="12,8">
                                    <Grid>
                                        <TextBox x:Name="SearchBox"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Height="34"
                                                 Padding="32,0,10,0"
                                                 VerticalContentAlignment="Center"
                                                 GotFocus="SearchBox_GotFocus"
                                                 LostFocus="SearchBox_LostFocus"
                                                 TextChanged="SearchBox_TextChanged"/>
                                        <Viewbox Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                                            <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsMuted}" Data="{x:Static ui:AppIcons.SearchOutlined}"/>
                                        </Viewbox>
                                        <TextBlock x:Name="SearchPlaceholder"
                                                   Text="{ui:Loc Send_SearchPlaceholder}"
                                                   Foreground="{DynamicResource SettingsMuted}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="32,0,0,0"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>

                                <!-- Contacts List -->
                                <ListBox x:Name="ContactsListBox"
                                         Grid.Row="1"
                                         Background="{DynamicResource SettingsTransparent}"
                                         BorderThickness="0"
                                         Padding="6,4"
                                         ClipToBounds="True"
                                         ScrollViewer.CanContentScroll="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="ContactsListBox_SelectionChanged">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    ClipToBounds="True">
                                                <ScrollViewer x:Name="PART_ScrollViewer"
                                                              Style="{StaticResource PageScrollViewer}"
                                                              Focusable="False"
                                                              Padding="{TemplateBinding Padding}"
                                                              CanContentScroll="False"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter x:Name="ContactsItemsPresenter"
                                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </ScrollViewer>
                                            </Border>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="effects:ControlRippleHost.IsEnabled" Value="True"/>
                                            <Setter Property="Background" Value="{DynamicResource SettingsTransparent}"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{DynamicResource SettingsTransparent}"
                                                                BorderThickness="1"
                                                                CornerRadius="5"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SettingsHover}"/>
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource SettingsLine}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SettingsSelected}"/>
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource SettingsAccentLine}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Initials Avatar -->
                                                <Border Grid.Column="0"
                                                        Width="32" Height="32"
                                                        CornerRadius="16"
                                                        Background="{Binding AvatarBgColor}"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Initials}"
                                                               Foreground="#FFFFFF"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Name & Details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource RowTitle}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplaySubtitle}"
                                                               Style="{StaticResource RowSubtitle}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Loading / Empty indicator -->
                                <TextBlock x:Name="ContactsStatusText"
                                           Grid.Row="1"
                                           Text="{ui:Loc Send_LoadingContactsList}"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>

                                <!-- Contacts Loading Overlay (Inside Contacts Block) -->
                                <Grid x:Name="ContactsLoadingOverlay"
                                      Grid.Row="1"
                                      Visibility="Collapsed"
                                      Panel.ZIndex="20">
                                    <Border x:Name="ContactsLoadingBackdrop"
                                            Background="{DynamicResource SettingsCard}"
                                            Opacity="0"/>
                                    <StackPanel x:Name="ContactsLoadingCenterPanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <ui:LoadingIndicatorVisual x:Name="ContactsLoadingSpinner"
                                                                   Width="48"
                                                                   Height="48"
                                                                   Fill="{DynamicResource SettingsAccent}"
                                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ContactsLoadingStatus"
                                                   Text="{ui:Loc Send_LoadingContacts}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource SettingsText}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Section: Optional Comment -->
                    <StackPanel Grid.Row="2" Margin="0,2,0,0">
                        <TextBlock Text="{ui:Loc Send_Comment_Title}" Style="{StaticResource SectionTitle}" Margin="2,4,0,6"/>
                        <Border Style="{StaticResource Card}" Padding="12,10">
                            <Grid>
                                <TextBox x:Name="MessageTextBox"
                                         Style="{StaticResource ModernTextBox}"
                                         Height="44"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Padding="10,6"
                                         VerticalContentAlignment="Top"
                                         GotFocus="MessageTextBox_GotFocus"
                                         LostFocus="MessageTextBox_LostFocus"
                                         TextChanged="MessageTextBox_TextChanged"/>
                                <TextBlock x:Name="MessagePlaceholder"
                                           Text="{ui:Loc Send_CommentPlaceholder}"
                                           Foreground="{DynamicResource SettingsMuted}"
                                           FontSize="12"
                                           VerticalAlignment="Top"
                                           Margin="12,7,0,0"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Section: Upload Progress (Shown during upload) -->
                    <Border x:Name="ProgressCard" Grid.Row="3" Style="{StaticResource Card}" Visibility="Collapsed" Padding="14,12" Margin="0,4,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsAccent}" Data="{x:Static ui:AppIcons.CloudUploadOutlined}"/>
                                    </Viewbox>
                                    <TextBlock x:Name="ProgressStatusText"
                                               Text="{ui:Loc Send_Progress_UploadingGoogleDrive}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SettingsAccent}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ProgressPercentText"
                                           Text="0%"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SettingsText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <ProgressBar x:Name="UploadProgressBar"
                                         Style="{StaticResource ModernProgressBar}"
                                         Height="6"/>

                            <TextBlock x:Name="ProgressDetailsText"
                                       Text="{ui:Loc Send_Progress_InitialDetails}"
                                       Style="{StaticResource RowSubtitle}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Action Buttons -->
                    <Grid Grid.Row="4" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SendButton"
                                Grid.Column="0"
                                Style="{StaticResource PrimaryButton}"
                                Height="42"
                                Click="SendButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.SendOutlined}"/>
                                </Viewbox>
                                <TextBlock Text="{ui:Loc Send_Button_UploadAndSend}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CloseButton"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Height="42"
                                Margin="8,0,0,0"
                                Padding="16,0"
                                Click="CloseButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.CloseOutlined}"/>
                                </Viewbox>
                                <TextBlock Text="{ui:Loc Common_Close}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- 2. SETTINGS VIEW (CircleToSearch Partitioned Card Rows) -->
                <ScrollViewer x:Name="SettingsView"
                              Style="{StaticResource PageScrollViewer}"
                              BorderThickness="0"
                              Background="{DynamicResource SettingsTransparent}"
                              FocusVisualStyle="{x:Null}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Visibility="Collapsed">
                    <StackPanel x:Name="SettingsContentPanel" Margin="0,0,6,0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform/>
                        </StackPanel.RenderTransform>

                        <!-- SECTION 1: TELEGRAM -->
                        <TextBlock Text="{ui:Loc Settings_Tg_SectionTitle}" Style="{StaticResource SectionTitle}" Margin="2,0,0,6"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <!-- Row 1: API ID -->
                                <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,0,0,0" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsAccent}" Data="{x:Static ui:AppIcons.KeyOutlined}"/>
                                        </Viewbox>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{ui:Loc Settings_Tg_ApiId_Title}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{ui:Loc Settings_Tg_ApiId_Desc}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                        <TextBox x:Name="TgApiIdBox" Grid.Column="3" Width="160" Style="{StaticResource ModernTextBox}"/>
                                    </Grid>
                                </Border>

                                <!-- Row 2: API Hash -->
                                <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsAccent}" Data="{x:Static ui:AppIcons.LockOutlined}"/>
                                        </Viewbox>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{ui:Loc Settings_Tg_ApiHash_Title}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{ui:Loc Settings_Tg_ApiHash_Desc}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                        <ui:MaskedInputField x:Name="TgApiHashBox" Grid.Column="3" Width="200"/>
                                    </Grid>
                                </Border>

                                <!-- Row 3: Phone Number -->
                                <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsAccent}" Data="{x:Static ui:AppIcons.PhoneOutlined}"/>
                                        </Viewbox>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{ui:Loc Settings_Tg_Phone_Title}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{ui:Loc Settings_Tg_Phone_Desc}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                        <ui:MaskedInputField x:Name="TgPhoneBox" Grid.Column="3" Width="160"/>
                                    </Grid>
                                </Border>

                                <!-- Footer Row: Status & Actions -->
                                <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0"
                                        Background="{DynamicResource SettingsWash}" Padding="16,10">
                                    <Grid>
                                        <Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="TgStatusDot" Width="7" Height="7" Fill="{DynamicResource SettingsMuted}" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="TgStatusBadge" Text="{ui:Loc Status_NotConnected}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SettingsMuted}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button x:Name="TgLogoutBtn"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Visibility="Collapsed"
                                                    Click="TgLogoutBtn_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.LogoutOutlined}"/>
                                                    </Viewbox>
                                                    <TextBlock Text="{ui:Loc Common_Logout}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="TgLoginBtn"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="TgLoginBtn_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.LoginOutlined}"/>
                                                    </Viewbox>
                                                    <TextBlock Text="{ui:Loc Settings_Tg_LoginBtn}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 2: GOOGLE DRIVE -->
                        <TextBlock Text="{ui:Loc Settings_GDrive_SectionTitle}" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <!-- Row 1: Load Secret JSON -->
                                <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,0,0,0" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsAccent}" Data="{x:Static ui:AppIcons.FileOpenOutlined}"/>
                                        </Viewbox>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{ui:Loc Settings_GDrive_SecretFile_Title}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{ui:Loc Settings_GDrive_SecretFile_Desc}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                        <Button x:Name="LoadSecretJsonBtn"
                                                Grid.Column="3"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="LoadSecretJsonBtn_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.UploadOutlined}"/>
                                                </Viewbox>
                                                <TextBlock Text="{ui:Loc Settings_GDrive_LoadJsonBtn}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Row 2: Client ID -->
                                <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsAccent}" Data="{x:Static ui:AppIcons.KeyOutlined}"/>
                                        </Viewbox>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{ui:Loc Settings_GDrive_ClientId_Title}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{ui:Loc Settings_GDrive_ClientId_Desc}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                        <TextBox x:Name="GoogleClientIdBox" Grid.Column="3" Width="180" Style="{StaticResource ModernTextBox}"/>
                                    </Grid>
                                </Border>

                                <!-- Row 3: Client Secret -->
                                <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsAccent}" Data="{x:Static ui:AppIcons.LockOutlined}"/>
                                        </Viewbox>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{ui:Loc Settings_GDrive_ClientSecret_Title}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{ui:Loc Settings_GDrive_ClientSecret_Desc}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                        <ui:MaskedInputField x:Name="GoogleClientSecretBox" Grid.Column="3" Width="180"/>
                                    </Grid>
                                </Border>

                                <!-- Footer Row: Status & Actions -->
                                <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0"
                                        Background="{DynamicResource SettingsWash}" Padding="16,10">
                                    <Grid>
                                        <Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="GoogleStatusDot" Width="7" Height="7" Fill="{DynamicResource SettingsMuted}" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="GoogleStatusBadge" Text="{ui:Loc Status_NotConnected}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SettingsMuted}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button x:Name="GoogleResetBtn"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Visibility="Collapsed"
                                                    Click="GoogleResetBtn_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.LogoutOutlined}"/>
                                                    </Viewbox>
                                                    <TextBlock Text="{ui:Loc Common_Logout}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="GoogleAuthBtn"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="GoogleAuthBtn_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.CheckOutlined}"/>
                                                    </Viewbox>
                                                    <TextBlock Text="{ui:Loc Settings_GDrive_AuthBtn}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 3: WINDOWS INTEGRATION -->
                        <TextBlock Text="{ui:Loc Settings_Win_SectionTitle}" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,0,0,0" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsAccent}" Data="{x:Static ui:AppIcons.ShortcutOutlined}"/>
                                        </Viewbox>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{ui:Loc Settings_Win_SendTo_Title}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{ui:Loc Settings_Win_SendTo_Desc}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>

                                        <Border Grid.Column="3" Style="{StaticResource StatusBadge}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="SendToStatusDot" Width="7" Height="7" Fill="{DynamicResource SettingsMuted}" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="SendToStatusBadge" Text="{ui:Loc Status_Checking}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SettingsMuted}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0"
                                        Background="{DynamicResource SettingsWash}" Padding="16,10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="RemoveSendToBtn"
                                                Style="{StaticResource SecondaryButton}"
                                                Visibility="Collapsed"
                                                Click="RemoveSendToBtn_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.DeleteOutlined}"/>
                                                </Viewbox>
                                                <TextBlock Text="{ui:Loc Common_Delete}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="AddSendToBtn"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="AddSendToBtn_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.AddOutlined}"/>
                                                </Viewbox>
                                                <TextBlock Text="{ui:Loc Settings_Win_AddSendToBtn}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 4: OPTIONS -->
                        <TextBlock Text="{ui:Loc Settings_Options_SectionTitle}" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <!-- Row 1: Language -->
                                <Border x:Name="LanguageRow" BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,0,0,1" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsAccent}" Data="{x:Static ui:AppIcons.LanguageOutlined}"/>
                                        </Viewbox>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{ui:Loc Settings_Options_Language_Title}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{ui:Loc Settings_Options_Language_Desc}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="LanguageComboBox"
                                                  Grid.Column="3"
                                                  Width="150"
                                                  Height="32"
                                                  Style="{StaticResource ModernComboBox}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Code"
                                                  SelectionChanged="LanguageComboBox_SelectionChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Row 2: Auto Close -->
                                <Border Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsAccent}" Data="{x:Static ui:AppIcons.TuneOutlined}"/>
                                        </Viewbox>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{ui:Loc Settings_Options_AutoClose_Title}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{ui:Loc Settings_Options_AutoClose_Desc}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AutoCloseCheckBox"
                                                  Grid.Column="3"
                                                  Style="{StaticResource Toggle}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="True"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 5: BACKUP & RESTORE -->
                        <TextBlock Text="{ui:Loc Settings_Backup_SectionTitle}" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,0,0,0" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource OutlineIconDirect}" Stroke="{DynamicResource SettingsAccent}" Data="{x:Static ui:AppIcons.RestoreOutlined}"/>
                                        </Viewbox>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{ui:Loc Settings_Backup_Title}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{ui:Loc Settings_Backup_Desc}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0"
                                        Background="{DynamicResource SettingsWash}" Padding="16,10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="RestoreBackupBtn"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,0"
                                                Click="RestoreBackupBtn_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.UploadOutlined}"/>
                                                </Viewbox>
                                                <TextBlock Text="{ui:Loc Settings_Backup_RestoreBtn}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="CreateBackupBtn"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="CreateBackupBtn_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.SaveOutlined}"/>
                                                </Viewbox>
                                                <TextBlock Text="{ui:Loc Settings_Backup_CreateBtn}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Save & Return Button -->
                        <Button x:Name="SaveSettingsBtn"
                                Style="{StaticResource PrimaryButton}"
                                Height="42"
                                Margin="0,6,0,16"
                                Click="SaveSettingsBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:AppIcons.SaveOutlined}"/>
                                </Viewbox>
                                <TextBlock Text="{ui:Loc Settings_SaveAndReturnBtn}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </AdornerDecorator>
    </Grid>
</Window>
