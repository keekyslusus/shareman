<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:effects="clr-namespace:GDriveTelegramSender.Ui.Effects"
                    xmlns:ui="clr-namespace:GDriveTelegramSender.Ui">

    <!-- Initial Fallback Theme Brushes & Colors (Overwritten dynamically by ThemeManager) -->
    <SolidColorBrush x:Key="SettingsPaper" Color="#202124"/>
    <SolidColorBrush x:Key="SettingsSurface" Color="#292A2D"/>
    <SolidColorBrush x:Key="SettingsCard" Color="#2D2F34"/>
    <SolidColorBrush x:Key="SettingsWash" Color="#25262A"/>
    <SolidColorBrush x:Key="SettingsLine" Color="#3C4043"/>
    <SolidColorBrush x:Key="SettingsHover" Color="#35373B"/>
    <SolidColorBrush x:Key="SettingsSelected" Color="#323846"/>
    <SolidColorBrush x:Key="SettingsText" Color="#E8EAED"/>
    <SolidColorBrush x:Key="SettingsMuted" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="SettingsAccent" Color="#D0BCFF"/>
    <SolidColorBrush x:Key="SettingsAccentForeground" Color="#202124"/>
    <SolidColorBrush x:Key="SettingsAccentLine" Color="#4A6DA7"/>
    <SolidColorBrush x:Key="SettingsHeroStart" Color="#313642"/>
    <SolidColorBrush x:Key="SettingsHeroEnd" Color="#272A32"/>
    <Color x:Key="SettingsHeroStartColor">#313642</Color>
    <Color x:Key="SettingsHeroEndColor">#272A32</Color>
    <SolidColorBrush x:Key="SettingsSuccess" Color="#81C995"/>
    <SolidColorBrush x:Key="SettingsWarning" Color="#FDD663"/>
    <SolidColorBrush x:Key="SettingsError" Color="#F28B82"/>
    <SolidColorBrush x:Key="SettingsTransparent" Color="Transparent"/>
    <SolidColorBrush x:Key="SettingsSectionTitle" Color="#000000"/>
    <Color x:Key="SettingsSectionTitleColor">#000000</Color>
    <SolidColorBrush x:Key="SettingsScrollbarThumb" Color="#8F30343A"/>
    <Color x:Key="SettingsScrollbarThumbColor">#8F30343A</Color>

    <!-- Outline Icon Styles (Material Icons Outlined without Fill) -->
    <Style x:Key="OutlineIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="1.65"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <Style x:Key="OutlineIconDirect" TargetType="Path">
        <Setter Property="StrokeThickness" Value="1.65"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <!-- Typography (CircleToSearch Hierarchy) -->
    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="RowSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsSectionTitle}"/>
        <Setter Property="Margin" Value="2,16,0,6"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Modern ToolTip Style -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SettingsSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Focus Ring -->
    <Style x:Key="FocusRing" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource SettingsAccent}" BorderThickness="2" CornerRadius="5" Margin="-3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card Base Style (Distinct Elevated Surface - CTS CornerRadius 7) -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="CardPanel" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14"/>
    </Style>

    <!-- Hero Card Style (Subtle Gradient Elevated - CTS CornerRadius 9) -->
    <Style x:Key="Hero" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsAccentLine}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                    <GradientStop Color="{DynamicResource SettingsHeroStartColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource SettingsHeroEndColor}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status Chip / Badge Style (CTS CornerRadius 5) -->
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Base Button with ControlRippleHost and Tactile 3D Bottom Border (CTS CornerRadius 5) -->
    <Style TargetType="Button">
        <Setter Property="effects:ControlRippleHost.IsEnabled" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
        <Setter Property="Background" Value="{DynamicResource SettingsSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsLine}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="13,7"/>
        <Setter Property="MinHeight" Value="33"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <Border x:Name="Hover" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SettingsHover}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsAccentLine}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SettingsSelected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Button (Google Accent with high-contrast text) -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SettingsAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsAccentForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsAccentLine}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <Border x:Name="Hover" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SettingsHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SettingsSelected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SettingsSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsLine}"/>
    </Style>

    <!-- Modern Input Field (TextBox - CTS CornerRadius 5) -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SettingsSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource SettingsText}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource SettingsAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsLine}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="33"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SettingsAccentLine}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern PasswordBox (CTS CornerRadius 5) -->
    <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource SettingsSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource SettingsText}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource SettingsAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsLine}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="33"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SettingsAccentLine}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Material 3 Animated Toggle Switch -->
    <Style x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="effects:ControlRippleHost.IsEnabled" Value="True"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="{DynamicResource SettingsTransparent}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{x:Static ui:UiAnimationPolicy.ToggleTransitionDuration}">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="OffTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="OnThumb" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="OffThumb" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Indeterminate"/>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="OffTrack" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="OnThumb" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="OffThumb" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="OffTrack" RadiusX="10" RadiusY="10" Stroke="{DynamicResource SettingsMuted}" StrokeThickness="1"/>
                        <Rectangle x:Name="OnTrack" RadiusX="10" RadiusY="10" Fill="{DynamicResource SettingsAccent}" Opacity="0"/>
                        <Grid x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Ellipse x:Name="OffThumb" Fill="{DynamicResource SettingsMuted}"/>
                            <Ellipse x:Name="OnThumb" Fill="{DynamicResource SettingsAccentForeground}" Opacity="0"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Sleek ProgressBar -->
    <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource SettingsSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
                        <Border x:Name="PART_Track" CornerRadius="3" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource SettingsAccent}" CornerRadius="3"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CircleToSearch Fading Overlay ScrollBar & ScrollViewer -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{DynamicResource SettingsTransparent}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Width" Value="{DynamicResource SettingsScrollTrackWidth}"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{DynamicResource SettingsTransparent}">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb OverridesDefaultStyle="True" MinHeight="{DynamicResource SettingsScrollMinThumbHeight}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource SettingsScrollbarThumb}"
                                                    Width="{DynamicResource SettingsScrollThumbWidth}"
                                                    HorizontalAlignment="Right"
                                                    CornerRadius="2"
                                                    Margin="{DynamicResource SettingsScrollThumbMargin}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid ClipToBounds="True">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Content="{TemplateBinding Content}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   HorizontalAlignment="Right"
                                   Margin="{DynamicResource SettingsScrollTrackMargin}"
                                   Style="{StaticResource SettingsScrollBar}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}"/>
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageScrollViewer}"/>

    <!-- Modern ComboBox (CTS CornerRadius 5) -->
    <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <Border x:Name="Frame"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="1"
                      Data="M7 10l5 5 5-5"
                      Stroke="{DynamicResource SettingsMuted}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="12" Height="8"
                      Stretch="Uniform"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SettingsAccentLine}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
        <Setter Property="Background" Value="{DynamicResource SettingsTransparent}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            Margin="2,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SettingsHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SettingsSelected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SettingsAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
        <Setter Property="Background" Value="{DynamicResource SettingsSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsLine}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="33"/>
        <Setter Property="Padding" Value="10,0,30,0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Template="{StaticResource ComboBoxToggleButtonTemplate}"/>
                        <ContentPresenter IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               Focusable="False">
                            <Border x:Name="DropDown"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource SettingsCard}"
                                    BorderBrush="{DynamicResource SettingsLine}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="2,4"
                                    Margin="0,4,0,0">
                                <ScrollViewer CanContentScroll="True"
                                              Focusable="False"
                                              Style="{StaticResource PageScrollViewer}">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
